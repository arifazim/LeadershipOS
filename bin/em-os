#!/usr/bin/env bash
# Unix wrapper for EM-OS CLI (macOS/Linux). Windows users can use bin/em-os.ps1.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

PYTHON="${PYTHON:-python3}"
if ! command -v "$PYTHON" >/dev/null 2>&1; then
  PYTHON="python"
fi

exec "$PYTHON" scripts/cli.py "$@"
